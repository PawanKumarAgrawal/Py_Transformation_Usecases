    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport pandas as pd\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\n\r\nData = IN[0]\r\n\r\ndf = pd.read_excel(Data)\r\n\r\n# Function to process email anomalies and create flags\r\ndef process_email(email):\r\n    flag = ''\r\n    if not email:\r\n        flag = 'Not_an_email'\r\n    elif '@' not in email:\r\n        flag = 'DomainName_missing'\r\n    elif '.' not in email.split('@')[-1] or '.' == email.split('@')[-1]:\r\n        flag = 'Incomplete_DomainName'\r\n    elif not email.split('@')[0]:\r\n        flag = 'Incomplete_Username'\r\n    elif not email.split('@')[-1].split('.')[0]:\r\n        flag = 'Incomplete_DomainName'\r\n    return flag\r\n\r\n# Applying the function to create flags\r\ndf['Flag'] = df['Email'].apply(process_email)\r\n\r\n\r\n\r\n\r\n\r\n# Assign your output to the OUT variable.\r\noutput_path = IN[1]\r\n\r\n# Save final_df2 to Excel\r\ndf.to_excel(output_path, index=False)\r\n\r\nOUT = output_path",
      "Engine": "CPython3",
      "VariableInputPorts": true,
