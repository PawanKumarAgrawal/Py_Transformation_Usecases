    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\n# Add references\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Extract the list from the input\r\ncombined_column = IN[0]\r\n\r\n# Create a DataFrame from the list\r\ndf = pd.DataFrame({'Combined_Column': combined_column})\r\n\r\n# Specify the separator(s)\r\nseparators = '|'.join(['-', ',', ';'])  # Combine separators into a regex pattern\r\n# Add more separators as needed\r\n\r\n# Split the combined column based on the specified separators\r\ndf_split = df['Combined_Column'].str.split(separators, expand=True)\r\n\r\n# Rename the columns if needed\r\ndf_split.columns = [f'Column{i}' for i in range(1, df_split.shape[1] + 1)]\r\n\r\n# Transpose the DataFrame and convert to a list of lists\r\nsplit_columns = df_split.T.values.tolist()\r\n\r\n# Assign the split columns to the OUT variables.\r\nOUT = split_columns\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "82a874076c8c47038b7bdb3af52b44c2",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "512d6f2925f641f59dca824160e2d122",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "50410fc434f046c294b4e379b4e243de",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
