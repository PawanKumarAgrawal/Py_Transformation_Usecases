    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\n# Add references\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Assuming 'IN[0]' is your 'Profit' column, create a DataFrame\r\ndf = pd.DataFrame({'Sales': IN[0]})\r\n\r\n# Fill missing values in the 'Sales' column with 0\r\ndf['Sales'] = df['Sales'].fillna(0)\r\n\r\n# Displaying the resulting table with Missing Values handled\r\ndf_new = df[['Sales']]\r\n\r\n# Convert the DataFrame to a list of dictionaries\r\nresult_list = df_new.values.tolist()\r\n\r\nOUT = result_list",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "82a874076c8c47038b7bdb3af52b44c2",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "512d6f2925f641f59dca824160e2d122",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "50410fc434f046c294b4e379b4e243de",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
