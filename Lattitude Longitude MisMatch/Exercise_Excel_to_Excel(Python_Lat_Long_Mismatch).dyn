    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport pandas as pd\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\n\r\nData = IN[0]\r\n\r\ndata = pd.read_excel(Data)\r\n\r\n# Function to fix the direction anomaly and create a new column\r\ndef fix_direction(row):\r\n    new_lat = row['Latitude']\r\n    new_long = row['Longitude']\r\n    \r\n    # Check if latitude and longitude need to be flipped\r\n    if row['Latitude'][-1] not in ('N', 'S') and row['Longitude'][-1] not in ('E', 'W'):\r\n        new_lat = row['Longitude']\r\n        new_long = row['Latitude']\r\n        fix_action = 'Direction exchanged to fix the anomaly'\r\n    else:\r\n        fix_action = ''\r\n    \r\n    return pd.Series([new_lat, new_long, fix_action], index=['Latitude', 'Longitude', 'Fix Action'])\r\n    \r\n\r\n# Apply the function to each row\r\ndata[['Latitude', 'Longitude', 'Fix Action']] = data.apply(fix_direction, axis=1)\r\n\r\n\r\nfinal_df = data[['DeliveryID', 'Location', 'Latitude', 'Longitude', 'Fix Action']]\r\n\r\n\r\n\r\n# Assign your output to the OUT variable.\r\noutput_path = IN[1]\r\n\r\n# Save final_df to Excel\r\nfinal_df.to_excel(output_path, index=False)\r\n\r\nOUT = output_path\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n# Assign your output to the OUT variable.\r\nOUT = 0",
      "Engine": "CPython3",
