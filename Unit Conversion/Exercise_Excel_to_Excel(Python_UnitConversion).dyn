    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport pandas as pd\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\nData1 = IN[0]\r\ndf_data = pd.read_excel(Data1)\r\n\r\nData2 = IN[1]\r\ndf_unit_conversion = pd.read_excel(Data2)\r\n\r\n# Function to split quantity and unit from weight string\r\ndef split_weight(weight_str):\r\n    quantity, unit = weight_str.split(' ')\r\n    return float(quantity), unit\r\n    \r\n\r\n# Apply split_weight function to df_data table\r\ndf_data[['Quantity', 'Unit']] = df_data['Weight'].apply(lambda x: pd.Series(split_weight(x)))\r\n\r\n\r\n# Merge df_data with unit_conversion table\r\nmerged_table = pd.merge(df_data, df_unit_conversion, left_on='Unit', right_on='To', how='left')\r\n\r\n\r\n# Calculate weights in kilograms\r\nmerged_table['Weight_in_kg'] = merged_table['Quantity'] / merged_table['Conversion Factor']\r\n\r\n\r\nfinal_df = merged_table[['ProductID', 'Name', 'Weight', 'Weight_in_kg']]\r\n\r\n\r\n\r\n# Assign your output to the OUT variable.\r\noutput_path = IN[2]\r\n\r\n# Save final_df to Excel\r\nfinal_df.to_excel(output_path, index=False)\r\n\r\nOUT = output_path",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "fac04d705d4a4429b1aaae01e73371d3",
      "NodeType": "PythonScriptNode",
