    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport pandas as pd\r\n\r\n# Add references\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Extract the columns from the input\r\ncolumn1 = IN[0]\r\ncolumn2 = IN[1]\r\n\r\n# Create a DataFrame\r\ndf = pd.DataFrame({ 'Column1': column1, 'Column2': column2 })\r\n\r\n# Apply lambda function to concatenate columns with a hyphen\r\ndf['Combined_Column'] = df.apply(lambda row: '-'.join(map(str, [row['Column1'], row['Column2']])), axis=1)\r\n\r\n# Extract the modified column\r\ncombined_column = df['Combined_Column'].tolist()\r\n\r\n# Assign the modified column to the OUT variable.\r\nOUT = combined_column\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "84addf621b4f446c8aa2af29aee18bac",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "88f0be09de6a4edfb67e6d7a9ee7bea8",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "8826c242a728437d8f1a370e38a21b6a",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "620d54dc3764412d90aff6501e2d24a9",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
