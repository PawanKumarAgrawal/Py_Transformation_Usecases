    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport pandas as pd\r\n\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\n\r\nData1 = IN[0]\r\nData2 = IN[1]\r\n\r\n# Load data from Excel files\r\nfile1 = pd.read_excel(Data1)\r\nfile2 = pd.read_excel(Data2)\r\n\r\n\r\n# Task 1: Inner join the two dataframes\r\njoined_table = pd.merge(file2, file1, how=\"left\", left_on=\"T_Commodity Title\", right_on=\"S_Commodity Title\")\r\n\r\n\r\n# Task 2: Create observations column\r\ndef classify(row):\r\n    if pd.isna(row['S_Commodity Title']):\r\n        return \"Commodity Title not in Standard Table\"\r\n    elif pd.isna(row['T_Commodity Code']):\r\n        return \"Unclassified\"\r\n    elif row['S_Commodity Code'] != row['T_Commodity Code']:\r\n        return \"Misclassified\"\r\n    else:\r\n        return \"Rightly Classified\"\r\n\r\njoined_table['Observations'] = joined_table.apply(classify, axis=1)\r\n\r\n\r\n# Task 3: Create suggestions column\r\ndef suggest(row):\r\n    if pd.isna(row['T_Commodity Code']):\r\n        return row['S_Commodity Code']\r\n    elif row['S_Commodity Code'] != row['T_Commodity Code']:\r\n        return row['S_Commodity Code']\r\n    else:\r\n        return row['T_Commodity Code']\r\n\r\njoined_table['Suggestions'] = joined_table.apply(suggest, axis=1)\r\n\r\n\r\n# Filter out rows that are rightly classified\r\nfiltered_table = joined_table[joined_table['Observations'] != 'Rightly Classified']\r\n\r\n\r\n\r\n# Assign your output to the OUT variable.\r\noutput_path = IN[2]\r\n\r\n# Save final_df to Excel\r\nfiltered_table.to_excel(output_path, index=False)\r\n\r\nOUT = output_path\r\n\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "a16ae99746f44917b2f2e3cd92b9384f",
