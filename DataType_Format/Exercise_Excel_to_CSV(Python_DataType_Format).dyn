    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport numpy as np\r\nimport pandas as pd\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\ndf = pd.read_excel(IN[0], usecols = ['Quantity', 'Discount'])\r\n\r\n\r\n# Convert 'Quantity' column from object to int16\r\ndf['Quantity'] = df['Quantity'].astype(np.int16)\r\n\r\n# Convert 'Discount' column from object to float32\r\ndf['Discount'] = df['Discount'].astype(np.float32)\r\n\r\n# Displaying the resulting table with Missing Values handled\r\ndf_new = df[['Quantity', 'Discount']]\r\n\r\n\r\n# Assign your output to the OUT variable.\r\noutput_path = IN[1]\r\n\r\n# Save final_df2 to Excel\r\ndf_new.to_excel(output_path, index=False)\r\n\r\nOUT = output_path",
      "Engine": "CPython3",
