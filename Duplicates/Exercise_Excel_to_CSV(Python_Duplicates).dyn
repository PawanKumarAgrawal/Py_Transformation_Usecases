    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nimport pandas as pd\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\n\r\ndf = pd.read_excel(IN[0])\r\n# Add a new column to flag duplicates\r\ndf['IsDuplicate'] = df.duplicated(subset=['Name', 'City'], keep=False)\r\n\r\n# Filter the DataFrame to include only rows where 'IsDuplicate' is True\r\ndf = df[df['IsDuplicate']]\r\n\r\n# Sort the DataFrame by 'Name' and 'City'\r\ndf = df.sort_values(by=['Name', 'City'])\r\n\r\n# Displaying the resulting table with outliers handled\r\ndf_new = df[['CustomerID', 'Name', 'City', 'IsDuplicate']]\r\n\r\n\r\n\r\n# Specify the output path\r\noutput_path = IN[1]\r\n\r\n# Save final_df2 to Excel\r\ndf_new.to_csv(output_path, index=False)\r\n\r\n# Assign the output path to the OUT variable\r\nOUT = output_path",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "c3f093147f494beda77ccfeb7b92d288",
      "NodeType": "PythonScriptNode",
